#!/bin/sh
set -eu
ROOT="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
DIST_VERSION="8.9"
DIST_DIR="${GRADLE_USER_HOME:-$HOME/.gradle}/wrapper/dists/jarvis-gradle-${DIST_VERSION}"
GRADLE_BIN="$DIST_DIR/gradle-${DIST_VERSION}/bin/gradle"
if command -v gradle >/dev/null 2>&1; then
  exec gradle "$@"
fi
if [ ! -x "$GRADLE_BIN" ]; then
  mkdir -p "$DIST_DIR"
  URL="https://services.gradle.org/distributions/gradle-${DIST_VERSION}-bin.zip"
  TMP="$DIST_DIR/gradle-${DIST_VERSION}-bin.zip"
  echo "Gradle ${DIST_VERSION} not installed; downloading it from ${URL}..." >&2
  if command -v curl >/dev/null 2>&1; then curl -fL --retry 3 -o "$TMP" "$URL"
  elif command -v wget >/dev/null 2>&1; then wget -O "$TMP" "$URL"
  else echo "curl or wget is required to bootstrap Gradle ${DIST_VERSION}." >&2; exit 1; fi
  if command -v unzip >/dev/null 2>&1; then unzip -q -o "$TMP" -d "$DIST_DIR"
  else echo "unzip is required to bootstrap Gradle ${DIST_VERSION}." >&2; exit 1; fi
  rm -f "$TMP"
fi
exec "$GRADLE_BIN" --project-dir "$ROOT" "$@"
